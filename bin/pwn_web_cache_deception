#!/usr/bin/env ruby
# frozen_string_literal: true

require 'pwn'
require 'uri'
require 'English'

opts = PWN::Env[:driver_opts]
PWN::Driver::Parser.new do |options|
  options.on('-tURL', '--target-url=URL', '<Required - URL to Target>') do |t|
    opts[:target_url] = t
  end

  options.on('-rRESULTS', '--output-results=RESULTS', '<Required - Path of Results File>') do |r|
    opts[:output_results] = r
  end

  options.on('-l', '---list-pwn-www-mods', '<Optional - Provide a List of PWN::WWW Modules to Support Post-AuthN w/ -m Flag') do |l|
    opts[:list_pwn_mods] = l
  end

  options.on('-mMOD', '--pwn-www-mod=MOD', '<Optional - PWN::WWW Module to Support Post-AuthN (-l to list Modules)') do |m|
    opts[:pwn_www_mod_str] = m
  end

  options.on('-uUSER', '--username=USER', '<Optional - PWN::WWW Module username') do |u|
    opts[:username] = u
  end

  options.on('-pPASS', '--password=PASS', '<Optional - PWN::WWW Module password (Will Prompt if nil)') do |p|
    opts[:password] = p
  end

  options.on('-f', '--[no-]mfa', '<Optional - Enable MFA PWN::WWW Module') do |f|
    opts[:mfa] = f
  end

  options.on('--yubikey-account=NAME', '<Optional - Exact OATH account; supports GitHub, Synack, Twitter, BugCrowd, CoinbasePro, AppCobaltIO; Paypal SMS adapter unsupported; requires --yubikey-confirm; enables MFA even with --no-mfa; never an OTP slot>') do |name|
    opts[:yubikey_account] = name
  end

  options.on('--yubikey-confirm', '<Required with --yubikey-account - Explicit OATH consent: HOTP advances counters; ykman may authenticate/delete remembered keys and delete corrupted OATH credentials>') do |confirm|
    opts[:yubikey_confirm] = confirm
  end

  options.on('--yubikey-serial=SERIAL', '<Optional - Decimal YubiKey serial; requires --yubikey-account>') do |serial|
    opts[:yubikey_serial] = serial
  end

  options.on('--proxy=PROXY', '<Optional - HTTP or Socks Proxy || tor>') do |p|
    opts[:proxy] = p
  end
end.parse!

# Colors!
@dark_red = "\e[1m\e[31m"
@green = "\e[32m"
@yellow = "\e[33m"
@end_of_color = "\e[0m"

# if -l Flag is passed, list all PWN::WWW Modules and exit
if opts[:list_pwn_mods]
  puts "#{@green}Available PWN::WWW modules to obtain a Post AuthN state:#{@end_of_color}:"
  puts "#{@yellow}#{PWN::WWW.help.join(',').tr(',', "\n")}#{@end_of_color}"
  exit
end

# Required Flag Variables
target_url = opts[:target_url].to_s.scrub.strip.chomp
output_results = opts[:output_results].to_s.scrub.strip.chomp
raise ArgumentError, '--target-url and --output-results are required' if target_url.empty? || output_results.empty?

begin
  target_uri = URI.parse(target_url)
rescue URI::InvalidURIError
  raise ArgumentError, 'Target URL must be an absolute HTTP or HTTPS URL'
end
raise ArgumentError, 'Target URL must be an absolute HTTP or HTTPS URL' unless %w[http https].include?(target_uri.scheme) && !target_uri.host.to_s.empty?
raise ArgumentError, 'Invalid output path' if output_results.include?("\0") || File.symlink?(output_results)
raise ArgumentError, 'Invalid output file or parent directory' unless File.directory?(File.dirname(output_results)) && File.writable?(File.dirname(output_results)) && (!File.exist?(output_results) || (File.file?(output_results) && File.writable?(output_results)))

# Optional Flag Variables
pwn_www_mod_str = opts[:pwn_www_mod_str].to_s.scrub.strip.chomp
unless pwn_www_mod_str.empty?
  begin
    pwn_www_mod = PWN::WWW.const_get(pwn_www_mod_str, false)
    raise ArgumentError, "Module PWN::WWW::#{pwn_www_mod_str} requires open, login, logout and close" unless %i[open login logout close].all? { |method| pwn_www_mod.respond_to?(method) }
  rescue NameError
    raise ArgumentError, "Invalid module PWN::WWW::#{pwn_www_mod_str}"
  end
end

username = opts[:username].to_s.scrub.strip.chomp

yubikey = nil
raise ArgumentError, 'YubiKey serial requires --yubikey-account with an exact OATH account name' if opts[:yubikey_account].nil? && !opts[:yubikey_serial].nil?
raise ArgumentError, '--yubikey-confirm requires --yubikey-account with an exact OATH account name' if opts[:yubikey_account].nil? && !opts[:yubikey_confirm].nil?

unless opts[:yubikey_account].nil?
  supported_oath_modules = %w[GitHub Synack Twitter BugCrowd CoinbasePro AppCobaltIO]
  raise ArgumentError, "YubiKey OATH is supported only with --pwn-www-mod=#{supported_oath_modules.join('|')}; the Paypal adapter is SMS-only" unless supported_oath_modules.include?(pwn_www_mod_str)

  yubikey = { account: opts[:yubikey_account], confirm: opts[:yubikey_confirm] }
  unless opts[:yubikey_serial].nil?
    serial = opts[:yubikey_serial]
    raise ArgumentError, 'YubiKey serial must be a decimal string without whitespace' unless serial.is_a?(String) && serial.match?(/\A[0-9]+\z/)

    yubikey[:serial] = serial
  end
  PWN::Plugins::AuthenticationHelper.validate_mfa_options(yubikey: yubikey, mfa: opts[:mfa], mfa_token: opts[:mfa_token])
end

password = opts[:password] # Don't cast to string to detect if PWN::Plugins::AuthenticationHelper is necessary
password = PWN::Plugins::AuthenticationHelper.mask_password if password.nil? && !pwn_www_mod_str.empty?

mfa = opts[:mfa] || false

proxy = opts[:proxy].to_s.scrub.strip.chomp unless opts[:proxy].nil?

begin
  def get_web_cache_deception(opts = {})
    browser_obj = opts[:browser_obj]
    target_url = opts[:target_url].to_s.scrub.chomp.strip
    payload = opts[:payload].to_s.scrub.chomp.strip

    # Browse to original page to compare response lengths
    browser = browser_obj[:browser]
    browser.goto(target_url)
    orig_url_response_length = browser.html.length

    http_result = ''
    if target_url.include?('?') || target_url.include?('#')
      injected_target_url = URI.parse(target_url)
      # Add non-existent file at the end of the path
      injected_target_url.path = "#{injected_target_url.path.to_s.chomp('/')}/wcd.#{payload}"
      web_cache_deception_url = injected_target_url.to_s

      browser.goto(injected_target_url.to_s)
      injected_url_response_length = browser.html.length

      if injected_url_response_length == orig_url_response_length
        # TODO: Add incognito Chrome browser
        puts "\n#{@dark_red}Alert! Potential Candidate: #{web_cache_deception_url}#{@end_of_color}\n"
        http_result = "Alert! Potential Candidate: #{web_cache_deception_url}"
      else
        print "#{@yellow}.#{@end_of_color}"
        http_result = "Response Length Mismatch: Orig Len: #{orig_url_response_length} | Inj Len: #{injected_url_response_length} | WCD: #{web_cache_deception_url}"
      end
    else
      web_cache_deception_url = "#{target_url.chomp('/')}/wcd.#{payload}"
      browser.goto(web_cache_deception_url)
      wcd_url_response_length = browser.html.length

      if orig_url_response_length == wcd_url_response_length
        # TODO: Add incognito Chrome browser
        puts "\n#{@dark_red}Alert! Potential Candidate: #{web_cache_deception_url}#{@end_of_color}\n"
        http_result = "Alert! Potential Candidate: #{web_cache_deception_url}"
      else
        print "#{@yellow}.#{@end_of_color}"
        http_result = "Response Length Mismatch: Orig Len: #{orig_url_response_length} | WCD Len: #{wcd_url_response_length} | WCD: #{web_cache_deception_url}"
      end
    end
  rescue Net::ReadTimeout => e
    http_result = "#{e} Orig: #{target_url} | WCD: #{web_cache_deception_url}"
  rescue StandardError => e
    raise e
  ensure
    http_result
  end

  # Script starts crunching here...
  if pwn_www_mod_str != ''
    puts "#{@green}Leveraging PWN::WWW::#{pwn_www_mod_str} to Obtain a Post AuhN State...#{@end_of_color}"
    if proxy
      browser_obj = pwn_www_mod.open(
        browser_type: :chrome,
        proxy: proxy
      )
    else
      browser_obj = pwn_www_mod.open(browser_type: :chrome)
    end
    # Now AuthN via PWN::WWW::<MODULE>
    owned_browser = browser_obj
    login_opts = {
      browser_obj: browser_obj,
      username: username,
      password: password,
      mfa: mfa
    }
    login_opts[:yubikey] = yubikey unless yubikey.nil?
    browser_obj = pwn_www_mod.login(login_opts)
    puts "#{@green}complete.#{@end_of_color}\n\n\n"
  elsif pwn_www_mod_str == '' && proxy
    browser_obj = PWN::Plugins::TransparentBrowser.open(
      browser_type: :chrome,
      proxy: proxy
    )
  else
    browser_obj = PWN::Plugins::TransparentBrowser.open(browser_type: :chrome)
  end

  owned_browser ||= browser_obj
  browser = browser_obj[:browser]

  puts "#{@green}Navigating to Target URL: #{target_url}#{@end_of_color}\n\n\n"
  browser.goto(target_url)

  web_cache_deception_payload_arr = %w[
    aif aiff au avi bin bmp cab carb cct cdf class css doc dcr dtd gcf gff gif grv hdml hqx ico ini jpeg jpg js mov mp3 mp4 nc pct ppc pws swa swf txt vbs w32 wav wbmp wml wmlc wmls wmlsc xsd zip
  ]

  File.open(output_results, 'w') do |f|
    web_cache_deception_payload_arr.each do |payload|
      http_result = get_web_cache_deception(
        browser_obj: browser_obj,
        target_url: target_url,
        payload: payload
      )

      f.puts http_result
    end
  end
  puts "\n#{@yellow}Results Location: #{output_results}#{@end_of_color}\n\n\n"
  puts "#{@green}complete.#{@end_of_color}"
rescue StandardError => e
  raise e
ensure
  primary_error = $ERROR_INFO
  cleanup_error = nil
  if owned_browser
    begin
      pwn_www_mod&.logout(browser_obj: owned_browser)
    rescue StandardError => e
      cleanup_error = e
    ensure
      begin
        (pwn_www_mod || PWN::Plugins::TransparentBrowser).close(browser_obj: owned_browser)
      rescue StandardError => e
        cleanup_error ||= e
      end
    end
  end
  raise cleanup_error if cleanup_error && !primary_error
end
