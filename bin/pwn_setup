#!/usr/bin/env ruby
# frozen_string_literal: true

require 'pwn'

opts = PWN::Env[:driver_opts]
pwn_driver = PWN::Driver::Parser.new do |options|
  options.banner = "USAGE: #{File.basename($PROGRAM_NAME)} [opts]\n       " \
                   "Post-install doctor & capability provisioner for the PWN gem.\n       " \
                   "With no options, runs a read-only capability check.\n"

  options.on('-c', '--check',
             '<Optional - Read-only doctor: which PWN capabilities are usable on this host? (default action)>') do |o|
    opts[:check] = o
  end

  options.on('-d', '--deps',
             '<Optional - Install OS headers + external tools + rebuild native gems for --profile (default: full)>') do |o|
    opts[:deps] = o
  end

  options.on('-pNAME', '--profile=NAME',
             "<Optional - Capability profile: #{PWN::Setup::PROFILES.keys.join(' | ')} (default: full)>") do |o|
    opts[:profile] = o
  end

  options.on('-l', '--list-profiles',
             '<Optional - List capability profiles and exit>') do |o|
    opts[:list] = o
  end

  options.on('-m', '--migrate',
             '<Optional - Verify ~/.pwn state files are compatible with this pwn version; apply schema migrations>') do |o|
    opts[:migrate] = o
  end

  options.on('-f', '--fix',
             '<Optional - With --migrate: also autofix incompatible files (backup taken first)>') do |o|
    opts[:fix] = o
  end

  options.on('-y', '--yes',
             '<Optional - Assume yes; non-interactive (CI-friendly)>') do |o|
    opts[:yes] = o
  end

  options.on('-t', '--terminal',
             '<Optional - Opt-in SHIFT+ENTER multi-line support: prints ~/.tmux.conf lines and, ' \
             'under Terminator, installs the PWNShiftEnter GTK plugin (with confirmation)>') do |o|
    opts[:terminal] = o
  end

  options.on('-n', '--dry-run',
             '<Optional - Print the commands that would run, do not execute>') do |o|
    opts[:dry_run] = o
  end

  options.on('--[no-]cron',
             '<Optional - Enable (default) or disable OS-native persistence of pwn-ai cron jobs>') do |o|
    opts[:cron] = o
  end
end
pwn_driver.auto_opts_help = false
pwn_driver.parse!

begin
  status = 0

  if opts[:list]
    PWN::Setup.list_profiles
  elsif opts[:migrate]
    r = PWN::Setup.migrate(
      fix: opts[:fix] || opts[:yes],
      dry_run: opts[:dry_run]
    )
    status = 1 unless r && r[:after] && r[:after][:incompatible].empty?
  elsif opts[:terminal]
    PWN::Setup.terminal(
      yes: opts[:yes],
      dry_run: opts[:dry_run]
    )
  elsif (opts[:deps] || opts[:profile]) && !opts[:check]
    PWN::Setup.deps(
      profile: opts[:profile],
      yes: opts[:yes],
      dry_run: opts[:dry_run]
    )
  else
    r = PWN::Setup.check(profile: opts[:profile])
    status = 1 unless r[:ok]
  end

  # One scheduler pass only. Skip list/terminal/dry-run. Skip migrate when a
  # worker is already live so `pwn setup --migrate` cannot spawn a second.
  unless opts[:list] || opts[:terminal] || opts[:dry_run]
    running = defined?(PWN::Cron) && PWN::Cron.worker_status[:running]
    unless opts[:migrate] && running
      cron_opts = { restart: false, dry_run: false }
      cron_opts[:enabled] = opts[:cron] unless opts[:cron].nil?
      PWN::Setup.ensure_cron(**cron_opts)
    end
  end
  exit status
rescue Interrupt
  puts "\naborted."
  exit 130
rescue StandardError => e
  warn "pwn_setup: #{e.class}: #{e.message}"
  exit 1
end
