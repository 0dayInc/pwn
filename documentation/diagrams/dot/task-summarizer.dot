digraph "PWN_TaskSummarizer" {
  graph [
    label=<<B>PWN::AI::Agent::TaskSummarizer - executive briefs</B><BR/><FONT POINT-SIZE="11" COLOR="#94a3b8">every request is a goal: emit_plan! then about_to then tools (no request type)</FONT>>,
    labelloc=t, fontsize=20, fontname="Helvetica",
    rankdir=TB, splines=spline, nodesep=0.55, ranksep=0.9,
    bgcolor="#0f172a", fontcolor="#e2e8f0", pad=0.6, newrank=true, compound=true
  ];
  node [fontname="Helvetica", fontsize=11, style="filled,rounded",
        shape=box, penwidth=1.4, color="#334155", fontcolor="#0f172a"];
  edge [fontname="Helvetica", fontsize=9, color="#94a3b8",
        fontcolor="#cbd5e1", penwidth=1.3, arrowsize=0.8];

  User  [label="User request", fillcolor="#7dd3fc"];
  Loop  [label="Loop.run\nts_state = TaskSummarizer.fresh\nrequest_intent short-circuit only", fillcolor="#c4b5fd"];
  Kind  [label="no request type\nevery other turn is a goal", fillcolor="#fcd34d", penwidth=2];
  {rank=same; User; Loop; Kind}

  subgraph cluster_short {
    label="Cheap short-circuits (no tools, no plan)"; fontcolor="#fda4af";
    style=rounded; color="#be123c"; bgcolor="#4c0519"; penwidth=2;
    Greet [label="greeting\nfixed short ack", fillcolor="#fda4af"];
    HowTo [label="howto\nexample commands only", fillcolor="#fda4af"];
    Recal [label="recall\nprior-turn answer", fillcolor="#fda4af"];
  }
  {rank=same; Greet; HowTo; Recal}

  subgraph cluster_plan {
    label="Goal plan (once per turn)"; fontcolor="#ddd6fe";
    style=rounded; color="#6d28d9"; bgcolor="#2e1065"; penwidth=2;
    Plan   [label="plan(request)\nenumerated · LLM · fallback\nordered work units", fillcolor="#c4b5fd"];
    EmitP  [label="emit_plan!\nGoal: (original request)\nTangible tasks (N):\n  each may use 1+ tools", fillcolor="#c4b5fd", penwidth=2];
  }
  {rank=same; Plan; EmitP}

  subgraph cluster_batch {
    label="Batch layer (each tool collection)"; fontcolor="#a7f3d0";
    style=rounded; color="#047857"; bgcolor="#022c22"; penwidth=2;
    About  [label="about_to(tools:)\ntask k/n English primary\nvia tools (intent)", fillcolor="#6ee7b7"];
    FP     [label="brief_fingerprint\nlast_brief_fp", fillcolor="#6ee7b7"];
    Dup    [label="duplicate_brief?", shape=diamond, fillcolor="#fcd34d"];
    EmitB  [label="emit task line\ntask k/N:\nvia shell (search)", fillcolor="#6ee7b7", penwidth=2];
    Skip   [label="return nil\n(suppress duplicate)", fillcolor="#fda4af"];
  }
  {rank=same; About; FP; Dup; EmitB; Skip}

  subgraph cluster_exec {
    label="Execution (not on task row)"; fontcolor="#fde68a";
    style=rounded; color="#a16207"; bgcolor="#422006"; penwidth=2;
    Tools  [label="Dispatch tools\nshell · pwn_eval · CORE_TOOLS\nown REPL lines", fillcolor="#fcd34d"];
    Rec    [label="record!\nadvance plan_idx\n(silent unless verbose)", fillcolor="#fcd34d"];
    Flush  [label="flush! / emit!\noptional closing brief", fillcolor="#fcd34d"];
  }
  {rank=same; Tools; Rec; Flush}

  UI [label="REPL on_tool\nname='task', full text, result=''\n(no truncation)", fillcolor="#7dd3fc"];

  User -> Loop [color="#38bdf8", penwidth=2];
  Loop -> Kind [color="#fbbf24", penwidth=2];
  Kind -> Greet [label="greeting", color="#fb7185"];
  Kind -> HowTo [label="howto", color="#fb7185"];
  Kind -> Recal [label="recall", color="#fb7185"];
  Kind -> Plan [label="goal", color="#a78bfa", penwidth=2];
  Plan -> EmitP [color="#a78bfa"];
  EmitP -> UI [label="full goal once", color="#38bdf8", penwidth=2];
  Loop -> About [label="before each\ntool batch", color="#a78bfa"];
  About -> FP [color="#34d399"];
  FP -> Dup [color="#34d399"];
  Dup -> EmitB [label="new", color="#34d399"];
  Dup -> Skip [label="same fp", color="#fb7185"];
  EmitB -> UI [color="#38bdf8", penwidth=2];
  EmitB -> Tools [color="#f59e0b"];
  Skip -> Tools [style=dashed, color="#94a3b8"];
  Tools -> Rec [color="#f59e0b"];
  Rec -> About [label="next batch", style=dashed, color="#94a3b8", constraint=false];
  Rec -> Flush [label="end of turn", color="#f59e0b"];
  Flush -> UI [style=dashed, color="#38bdf8"];
}
