digraph "PWN_Swarm" {
  graph [
    label=<<B>PWN::AI::Agent::Swarm - Native Multi-Agent Orchestration</B><BR/><FONT POINT-SIZE="11" COLOR="#94a3b8">personas · ask / debate / broadcast · shared bus (no daemon)</FONT>>,
    labelloc=t, fontsize=20, fontname="Helvetica",
    rankdir=TB, splines=polyline, nodesep=0.5, ranksep=0.5,
    bgcolor="#0f172a", fontcolor="#e2e8f0", pad=0.4, newrank=true, compound=true
  ];
  node [fontname="Helvetica", fontsize=11, style="filled,rounded",
        shape=box, penwidth=1.3, color="#334155", fontcolor="#0f172a",
        fillcolor="#c4b5fd", margin="0.22,0.16", width=4.5];
  edge [fontname="Helvetica", fontsize=10, color="#94a3b8",
        fontcolor="#cbd5e1", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_explicit {
    label="EXPLICIT DELEGATION  ·  operator / calling agent"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Entry [fillcolor="#7dd3fc", label="Choose target persona(s) + request in pwn-ai\nagent_ask: one turn / one persona\nagent_debate: ordered round-robin critique\nagent_broadcast: parallel fan-out ensemble"];
  }
  subgraph cluster_escalation {
    label="CONDITIONAL ESCALATION  ·  private Loop path"; fontsize=12;
    style="rounded,dashed,filled"; color="#94a3b8"; fillcolor="#1e293b";
    Escalate [label="Local Loop is stuck beyond failure threshold\nConfigured escalation_persona must exist\nAsk for a short frontier corrective hint\nLocal model still owns its final answer"];
  }
  {rank=same; Entry; Escalate}

  subgraph cluster_runtime {
    label="EXECUTION OWNER  ·  Swarm.ask → nested Loop"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Run [fillcolor="#6ee7b7", label="Select persona engine / model / skills / toolsets\nPer-persona session + recursion-depth guard\nAppend request; run nested Loop; append reply\nTools remain behind Dispatch / confirmation / sandbox\nNo daemon and no fixed provider-to-role assignment"];
  }
  Config [fillcolor="#fcd34d", label="PERSONA DEFINITION  ·  independent setup\nagent_spawn defines a persona in ~/.pwn/agents.yml\nDefinition alone does not execute a turn\nExamples: red_team / blue_team / recon / exploit_dev\nProvider and toolsets are configurable, not role guarantees"];
  {rank=same; Run; Config}

  subgraph cluster_handoff {
    label="RESULT BOUNDARY  ·  calling runtime retains responsibility"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Result [label="Return reply + session ID + child inbox / honesty data\nDebate passes the prior speaker's response onward\nBroadcast collects replies; escalation returns a hint\nReplies, consensus and bus entries are not completion proof\nParent must recheck child artifacts / evidence"];
  }
  subgraph cluster_state {
    label="CONTINUITY  ·  ~/.pwn/"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    State [fillcolor="#fcd34d", label="swarm/<id>/bus.jsonl: append-only conversation\nswarm/<id>/personas.json: name → session_id\nsessions/*.jsonl: per-persona transcripts\nUse swarm_id to join existing work; swarm_bus to inspect\nBus tail supplies context, not independent verification"];
  }
  {rank=same; Result; State}

  Entry -> Run [ltail=cluster_explicit, lhead=cluster_runtime, label="ask / debate / broadcast", color="#38bdf8", weight=10];
  Escalate -> Run [ltail=cluster_escalation, lhead=cluster_runtime, label="conditional hint request", style=dashed];
  Config -> Run [lhead=cluster_runtime, label="read definition", constraint=false];
  Run -> Result [ltail=cluster_runtime, lhead=cluster_handoff, label="observed child result", weight=10];
  Run -> State [ltail=cluster_runtime, lhead=cluster_state, label="retain request / reply / session", color="#f59e0b"];
}
