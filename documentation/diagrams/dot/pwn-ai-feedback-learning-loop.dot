digraph PWN_Feedback {
  graph [label="pwn-ai - evidence-backed feedback, not automatic improvement", labelloc=t,
    fontsize=20, fontname="Helvetica", rankdir=TB, bgcolor="#0f172a", fontcolor="#e2e8f0", pad=0.6];
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#c4b5fd", color="#334155"];
  edge [fontname="Helvetica", fontsize=9, color="#94a3b8", fontcolor="#cbd5e1"];
  Request [label="Original request + additive amendments", fillcolor="#7dd3fc"];
  Host [label="Living off the land\nDetectOS native PATH inventory API\nHOST injects OS summary + PreflightChecker health", fillcolor="#6ee7b7"];
  Prompt [label="PromptBuilder\nbudgeted memory / skills / lessons / mistakes / policy"];
  Loop [label="Loop / request-owned runtime\nTaskSummarizer compass is UX, not acceptance"];
  Tools [label="Registry -> Dispatch -> actual tools\npermissions / confirmation / sandbox"];
  World [label="Extrospection\non-demand observe / intel / watch / verify / RF etc.\nauto baseline: host / repo / env only", fillcolor="#fcd34d"];
  Evidence [label="Host receipts / exact-target stat + digest\nexecuted authored checks; failed/unknown stay distinct", shape=cylinder, fillcolor="#fcd34d"];
  Final [label="Completion arbiter\nno tool calls != done; all original obligations apply"];
  Reward [label="Reward + Learning\nclaimed_completion (judge claim)\nverified_completion / false_completion\nrate denominator: checked claims", fillcolor="#6ee7b7"];
  Mistakes [label="Mistakes / Metrics / Reflect\nfailures, fixes and diagnostic lessons\ncorrelation is not causal proof", fillcolor="#6ee7b7"];
  Policy [label="Policy accounting + advisory ranking\npositive training credit requires independent action attribution", fillcolor="#6ee7b7"];
  Regression [label="Learning.regression_task\nexact failure/request digest + operator-authored expected bytes\ninert file/JSON recipe; split remains regression"];
  Eval [label="Frozen local snapshot evaluation\nnew HOME / off + baseline + candidate\npublic held-out tasks; no live LLM gain claim"];
  Promote [label="Operator approval + stopped writers + explicit target\nfresh replay / per-task + aggregate gates\nversioned receipt / digest-bound rollback"];
  Skill [label="SkillReview default recommend\nauto-safe limited to proven additions to existing SOPs"];
  Weights [label="Curriculum export / optional trainer path\nseparate from routing-policy promotion\nnot proof that a live adapter improved"];
  Request -> Loop; Host -> Prompt; Prompt -> Loop; Loop -> Tools;
  Tools -> Evidence; Tools -> World; World -> Prompt [style=dashed];
  Evidence -> Final; Loop -> Final; Final -> Reward;
  Tools -> Mistakes; World -> Mistakes [label="correlate", style=dashed];
  Reward -> Policy; Reward -> Regression [label="persisted verifier failure"];
  Regression -> Eval [label="regression replay only; never relabel held-out", style=dashed];
  Policy -> Eval [label="explicit frozen snapshots"]; Eval -> Promote;
  Promote -> Policy [label="explicit local replace / rollback", style=dashed];
  Mistakes -> Prompt [style=dashed]; Reward -> Skill; Skill -> Prompt [style=dashed];
  Reward -> Weights [label="explicit opt-in"]; Policy -> Prompt [style=dashed];
}
