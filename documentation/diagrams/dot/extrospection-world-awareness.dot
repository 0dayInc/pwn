digraph "PWN_Extrospection" {
  graph [
    label=<<B>PWN::AI::Agent::Extrospection - On-demand sensing + ambient baseline</B><BR/><FONT POINT-SIZE="11" COLOR="#94a3b8">automatic host / repo / env only · other probes and actions are on demand · observations are not completion proof</FONT>>,
    labelloc=t, fontsize=20, fontname="Helvetica",
    rankdir=TB, splines=polyline, nodesep=0.45, ranksep=0.5,
    bgcolor="#0f172a", fontcolor="#e2e8f0", pad=0.4, newrank=true, compound=true
  ];
  node [fontname="Helvetica", fontsize=11, style="filled,rounded",
        shape=box, penwidth=1.3, color="#334155", fontcolor="#0f172a",
        fillcolor="#fcd34d", margin="0.22,0.16", width=3.8];
  edge [fontname="Helvetica", fontsize=10, color="#94a3b8",
        fontcolor="#cbd5e1", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_auto {
    label="AMBIENT BASELINE  ·  automatic scope"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Baseline [fillcolor="#7dd3fc", label="AUTO_SECTIONS = host / repo / env\nHost: OS / distribution / architecture\nRepository: HEAD / dirty state\nEnvironment: Ruby / gem information\nNo automatic network / RF / browser sensing"];
    Snapshot [label="SNAPSHOT + DRIFT\nextro_snapshot: selected probes\nextro_drift: delta against prior baseline\nExplicit snapshots can request other sections\nToolchain inventory uses safe version checks\nor PATH presence; not general tool execution"];
    Baseline -> Snapshot [label="auto_extrospect", color="#38bdf8"];
  }

  subgraph cluster_web {
    label="ON DEMAND  ·  web / public intelligence"; fontsize=12;
    style="rounded,dashed,filled"; color="#94a3b8"; fillcolor="#1e293b";
    Web [fillcolor="#6ee7b7", label="INDEPENDENT LOOKUPS / WATCHES\nextro_intel: NVD / CIRCL / Exploit-DB\nextro_osint: phone / FCC / patent / IP / person\nextro_watch: DOM hash / screenshot / TLS\nextro_verify: CVE / version / doc / generic\nWeb: TransparentBrowser headless → REST fallback"];
    Verdict [label="RECORDING / HEURISTIC VERDICTS\nIntel records when record:true; watch stores web data\nVerify: confirmed / refuted / unknown\nWith commit: confirmed → intel; refuted → Mistakes\nrevalidate_memory: confident refutation marks\n:fact [UNVERIFIED date] + stale web observation"];
    Web -> Verdict [label="selected operation"];
  }

  subgraph cluster_sense {
    label="ON DEMAND  ·  devices / media / observations"; fontsize=12;
    style="rounded,dashed,filled"; color="#94a3b8"; fillcolor="#1e293b";
    Sense [fillcolor="#6ee7b7", label="INDEPENDENT TOOLS / ACTIONS\nextro_rf_tune: GQRX / strength / RDS\nextro_serial: UART open / payload / drain\nextro_telecomm: BareSIP status / dial\nextro_packet: capture / pcap summary\nextro_vision: OCR / QR; extro_voice: TTS / STT"];
    Observe [label="OBSERVATION BOUNDARY\nOn-demand calls use available plugins / hardware\nActions may affect devices or external services\nextro_observe records supplied observations\nCategories: recon / vuln / intel / target / network\nenv / RF / web / OSINT / serial / telecomm\npacket / vision / voice"];
    Sense -> Observe [label="record operation results"];
  }
  {rank=same; Baseline; Web; Sense}
  {rank=same; Snapshot; Verdict; Observe}

  subgraph cluster_retention {
    label="RETAINED WORLD MODEL  ·  not ground truth"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Store [label="~/.pwn/extrospection.json\nSnapshot + baseline / categorized observations\nWatch screenshots: ~/.pwn/extrospection/web/*.png\nPersistence depends on operation / options", width=5.2];
    Context [fillcolor="#c4b5fd", label="extro_correlate: candidate correlations, not causal proof\nJoin world state with Metrics / Learning / Mistakes / Memory\nPromptBuilder: EXTROSPECTION when context is expanded\nBudgeted advisory context; recheck before relying on stale data", width=5.2];
    Store -> Context [label="read retained state", style=dashed];
  }
  Snapshot -> Store [ltail=cluster_auto, lhead=cluster_retention, label="snapshot / delta", color="#f59e0b"];
  Verdict -> Store [ltail=cluster_web, lhead=cluster_retention, label="recorded observations", color="#f59e0b"];
  Observe -> Store [ltail=cluster_sense, lhead=cluster_retention, label="categorized results", color="#f59e0b"];
}
