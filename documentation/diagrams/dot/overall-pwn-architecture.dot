digraph PWN_Architecture {
  graph [label="PWN - runtime ownership and evidence flow", labelloc=t, fontsize=22,
    fontname="Helvetica", rankdir=TB, bgcolor="#0f172a", fontcolor="#e2e8f0", pad=0.6];
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#c4b5fd", color="#334155"];
  edge [fontname="Helvetica", fontsize=9, color="#94a3b8", fontcolor="#cbd5e1"];
  Operator [label="Operator / CI", fillcolor="#7dd3fc"];
  Entry [label="pwn / pwn-ai CLI and curses\n56 executables total", fillcolor="#7dd3fc"];
  Mesh [label="pwn-mesh\nprimary radio or MQTT + optional secondary MQTT\n@ai / private channel / whitelist gate", fillcolor="#7dd3fc"];
  Runtime [label="RequestRuntime + Loop\noriginal objective / additive steering\ncheckpoint / permissions / uncertain effects"];
  Prompt [label="PromptBuilder\nmemory / skills / lessons / mistakes / policy\nHOST: DetectOS summary + PreflightChecker"];
  Registry [label="Registry: 16 toolsets / 150 tools\nnormal Loop: core-only + relevant MCP"];
  Provider [label="Configured provider adapter\nrequest-local routing and retry ownership", fillcolor="#fda4af"];
  Dispatch [label="Dispatch / ToolGuard / confirmation / sandbox"];
  Capabilities [label="107 plugin modules / 48 SAST modules\n90 AWS wrappers / 22 WWW drivers\nSDR / blockchain / reports / FFI", fillcolor="#6ee7b7"];
  Target [label="Authorized target / external service / hardware\nrequires separate live validation", fillcolor="#fda4af"];
  Evidence [label="Host observations / exact-target artifacts\nSessions / request checkpoints", shape=cylinder, fillcolor="#fcd34d"];
  Verify [label="Finalization arbiter + Verification\ncurrent bytes / authored checks / complete coverage"];
  Outcome [label="Verified / failed / unknown or incomplete\nnot model prose alone", fillcolor="#7dd3fc"];
  Learn [label="Reward / Learning / Mistakes / Metrics\nclaim and verified-completion fields\nPolicy positive credit needs attribution"];
  Stores [label="Default ~/.pwn stores\nplus explicit artifact/worktree paths", shape=cylinder, fillcolor="#fcd34d"];
  Swarm [label="Swarm nested Loop / Solve\nparent rechecks child artifact receipts"];
  Cron [label="Cron scheduler\nhygiene on / curriculum opt-in"];
  Operator -> Entry; Operator -> Mesh;
  Entry -> Runtime; Mesh -> Runtime [label="eligible received @ai only"];
  Runtime -> Prompt; Runtime -> Registry; Prompt -> Provider; Registry -> Provider;
  Provider -> Dispatch [label="tool calls"]; Dispatch -> Capabilities;
  Capabilities -> Target; Dispatch -> Evidence; Evidence -> Runtime [label="observations"];
  Runtime -> Verify; Evidence -> Verify; Verify -> Outcome;
  Outcome -> Learn; Learn -> Stores; Stores -> Prompt [style=dashed];
  Dispatch -> Swarm; Swarm -> Runtime [label="child turn", style=dashed];
  Cron -> Runtime [label="prompt jobs"]; Cron -> Learn [label="explicit maintenance"];
  Outcome -> Entry [label="release result", style=dashed];
  Outcome -> Mesh [label="origin-bound reply; submission != RF delivery", style=dashed];
}
