digraph PWN_Architecture {
  graph [
    label=<<B>PWN - Overall Architecture</B><BR/><FONT POINT-SIZE="11" COLOR="#94a3b8">runtime ownership · evidence flow · verified outcomes</FONT>>,
    labelloc=t, fontsize=20, fontname="Helvetica",
    rankdir=TB, splines=polyline, nodesep=0.5, ranksep=0.48,
    bgcolor="#0f172a", fontcolor="#e2e8f0", pad=0.4, newrank=true, compound=true
  ];
  node [fontname="Helvetica", fontsize=11, shape=box, style="filled,rounded",
        fillcolor="#c4b5fd", penwidth=1.3, color="#334155", fontcolor="#0f172a", margin="0.22,0.16"];
  edge [fontname="Helvetica", fontsize=10, color="#94a3b8",
        fontcolor="#cbd5e1", penwidth=1.3, arrowsize=0.8];

  // Ownership map, not a complete call graph. Internal repetition is summarized
  // inside Runtime; shared state and asynchronous work are not return arrows.
  subgraph cluster_entry {
    label="01  ACCESS  ·  operator / CI"; labelloc=t; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Entry [fillcolor="#7dd3fc", width=5.1,
      label="pwn / pwn-ai  ·  REPL, curses and headless CLI\npwn-mesh: received @ai + private channel + whitelist\nCron: asynchronous prompt jobs; curriculum opt-in"];
  }
  subgraph cluster_control {
    label="02  CONTROL  ·  request-owned agent runtime"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Runtime [width=5.1,
      label="RequestRuntime + Loop\nOwn objective, additive steering and checkpoints\nPromptBuilder + Registry: context and available tools\nRepeat tool / observation turns; optional Swarm / Solve"];
  }
  subgraph cluster_execution {
    label="03  EXECUTION  ·  host-owned tools"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Execute [fillcolor="#6ee7b7", width=5.1,
      label="Dispatch + ToolGuard + confirmation + sandbox\nPlugins / SAST / AWS / WWW / SDR / Blockchain / Reports\nShell, Ruby and MCP integrations\nDirect REPL / driver calls can also use these capabilities"];
  }
  subgraph cluster_evidence {
    label="04  ACCEPTANCE  ·  evidence, not model prose"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Accept [width=5.1,
      label="Host observations + exact-target artifact receipts\nFinalization arbiter + Verification: all obligations\nParent rechecks child artifacts; authored checks / current bytes\nRelease verified, failed, or unknown / incomplete result"];
  }
  subgraph cluster_state {
    label="05  RETENTION  ·  durable evidence and advisory context"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    State [fillcolor="#fcd34d", width=5.1,
      label="Sessions / Learning / Mistakes / Metrics / Policy\nDefault ~/.pwn stores; explicit artifacts may live elsewhere\nLater PromptBuilder reads memory, skills, lessons and policy\nCron hygiene is asynchronous; improvement is not automatic"];
  }
  Provider [fillcolor="#fda4af", label="MODEL BOUNDARY\nConfigured provider adapter\nRequest-local routing and retries\nModel output is not host evidence"];
  Target [fillcolor="#fda4af", label="WORLD BOUNDARY\nExternal services / targets / hardware\nLive behavior needs separate validation\nRadio submission is not RF delivery"];

  {rank=same; Runtime; Provider}
  {rank=same; Execute; Target}
  Entry -> Runtime [ltail=cluster_entry, lhead=cluster_control, label="agent requests", color="#38bdf8", weight=10];
  Runtime -> Execute [ltail=cluster_control, lhead=cluster_execution, label="selected tool calls", color="#38bdf8", weight=10];
  Execute -> Accept [ltail=cluster_execution, lhead=cluster_evidence, label="observed results / receipts", color="#38bdf8", weight=10];
  Accept -> State [ltail=cluster_evidence, lhead=cluster_state, label="record outcomes and evidence", weight=10];
  Runtime -> Provider [dir=both, label="context / proposals", constraint=false];
  Execute -> Target [dir=both, label="as required", style=dashed, constraint=false];
}
