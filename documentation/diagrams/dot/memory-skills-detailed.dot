digraph "PWN_MemorySkills" {
  graph [
    label=<<B>Persistent Knowledge - Memory · Skills · Learning · Mistakes · Policy · Sessions</B><BR/><FONT POINT-SIZE="11" COLOR="#94a3b8">durable context · explicit maintenance / export · storage is not verified success</FONT>>,
    labelloc=t, fontsize=20, fontname="Helvetica",
    rankdir=TB, splines=polyline, nodesep=0.5, ranksep=0.48,
    bgcolor="#0f172a", fontcolor="#e2e8f0", pad=0.4, newrank=true
  ];
  node [fontname="Helvetica", fontsize=11, style="filled,rounded",
        shape=box, penwidth=1.3, color="#334155", fontcolor="#0f172a",
        fillcolor="#c4b5fd", margin="0.22,0.16", width=5.0];
  edge [fontname="Helvetica", fontsize=10, color="#94a3b8",
        fontcolor="#cbd5e1", penwidth=1.3, arrowsize=0.8];

  // Store families replace one arrow per read/write API. Maintenance cards
  // are independent operations, not a chain invoked for every memory write.
  subgraph cluster_context {
    label="CONTEXT LIFECYCLE  ·  read top to bottom"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Write [fillcolor="#6ee7b7", label="1  RECORD THROUGH THE OWNING API\nMemory: memory_remember / lean\nSkills: skill_create / skill_add_reference\nLearning: note_outcome / reflect; Mistakes: record / resolve\nSessions: transcript append; Policy: episode accounting"];
    Stores [fillcolor="#fcd34d", label="2  RETAIN UNDER ~/.pwn/\nmemory.json: facts / preferences / lessons / environment\nmemory.idx: embedding index (incremental re-embed)\nskills/<n>/SKILL.md + references; default skill seeds\nlearning.jsonl + mistakes.json + sessions/*.jsonl\npolicy.json + policy_traj.jsonl; extrospection.json"];
    Read [label="3  SELECT RELEVANT CONTEXT\nMemory.recall / MemoryIndex.recall_semantic\nSkills list / view; Learning outcomes / stats\nSessions view / current; Mistakes list / correction_hint\nPolicy stats / evaluate / recommend: advisory only"];
    Prompt [fillcolor="#7dd3fc", label="4  PromptBuilder.build(request:)\nEngine-aware budget; relevance-ranked memory\nRecent turns + skills + learning + known mistakes / fixes\nExpanded / stuck context: metrics + policy + extrospection\nThin mode omits full memory / harness blocks"];
    Reuse [fillcolor="#7dd3fc", label="5  INFORM THE NEXT TURN\nSelected context, not a dump of every stored file\nLearning.exemplars_for: local-only few-shot traces\nStored lessons / judge claims are not host verification\nPositive policy credit needs independent action attribution"];
    Write -> Stores [color="#f59e0b"];
    Stores -> Read -> Prompt -> Reuse;
  }

  subgraph cluster_operations {
    label="MAINTENANCE / EXPORT  ·  independently invoked"; fontsize=12;
    style="rounded,dashed,filled"; color="#94a3b8"; fillcolor="#1e293b";
    Skill [fillcolor="#6ee7b7", label="SKILL MAINTENANCE\nlearning_distill_skill: explicit reviewed session distillation\nSkillReview: recommend by default\nauto-safe: small proven append to existing non-pwn/ SOP\nNot automatic skill creation after routine success"];
    Reflect [label="REFLECTION + CORRECTIONS\nReflect.on: teacher reads transcript → memory :lesson\nMistakes.resolve: correction → memory lesson\nResolution can also record a preference pair\nRetain source provenance; do not treat prose as proof"];
    Revalidate [label="WORLD-FACT REVALIDATION\nExtrospection.revalidate_memory (cron / explicit)\nSelect :fact entries containing CVE / version / URL\nRefuted with confidence ≥ 0.6 → [UNVERIFIED date]\nRecord stale web observation in extrospection.json"];
    Export [fillcolor="#fcd34d", label="DATASET EXPORT\nLearning.export_finetune: eligible verified outcomes\n+ session traces → ShareGPT / OpenAI datasets\nReward.record_preference → preferences.jsonl\nReward.export_dpo → finetune/*.jsonl\nExport does not train or promote a model"];
    Context [fillcolor="#1e293b", fontcolor="#cbd5e1", style="rounded,dashed,filled",
      label="READ / WRITE BOUNDARY\nThese operations read selected retained sources\nand write only their corresponding stores / artifacts.\nThey are not prerequisites for PromptBuilder.\nFrozen policy evaluation / promotion is a separate workflow."];
  }
  {rank=same; Write; Skill}
  {rank=same; Stores; Reflect}
  {rank=same; Read; Revalidate}
  {rank=same; Prompt; Export}
  {rank=same; Reuse; Context}
}
