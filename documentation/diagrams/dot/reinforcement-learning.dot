digraph "PWN_Reinforcement_Learning" {
  graph [
    label=<<B>PWN::AI::Agent - Reward + Curriculum Reinforcement Loop</B><BR/><FONT POINT-SIZE="11" COLOR="#94a3b8">live accounting · optional curriculum / weights · explicit routing-policy evaluation</FONT>>,
    labelloc=t, fontsize=20, fontname="Helvetica",
    rankdir=TB, splines=polyline, nodesep=0.45, ranksep=0.48,
    bgcolor="#0f172a", fontcolor="#e2e8f0", pad=0.4, newrank=true
  ];
  node [fontname="Helvetica", fontsize=11, style="filled,rounded",
        shape=box, penwidth=1.3, color="#334155", fontcolor="#0f172a",
        fillcolor="#c4b5fd", margin="0.20,0.16", width=3.8];
  edge [fontname="Helvetica", fontsize=10, color="#94a3b8",
        fontcolor="#cbd5e1", penwidth=1.3, arrowsize=0.8];

  // Independent lifecycles, not a mandatory pipeline from each live request.
  subgraph cluster_live {
    label="LIVE REQUEST  ·  Loop / Reward / Policy"; fontsize=12;
    style="rounded,filled"; color="#334155"; fillcolor="#1e293b";
    Run [fillcolor="#7dd3fc", label="1  ACT + OBSERVE\nLoop: plan, Dispatch, guard, final answer\nPolicy: begin_episode / observe_step\nsemantic_ok: grep exit 1 need not be failure"];
    Diagnose [label="2  DIAGNOSE WHEN APPLICABLE\nCurriculum: red_team_plan / critic\ncounterfactual: real vs imagined dispatch\nhindsight: achieved-goal relabel, not proof"];
    Evidence [fillcolor="#fcd34d", label="3  RESOLVE OUTCOME\nHost Verification: pass / fail / unknown\nReward.judge remains a fallible claim\nverify_as_reward: claim diagnostics / caps\nFalse rate = refuted / checked claims"];
    Credit [label="4  ACCOUNT FOR ELIGIBLE CREDIT\nPolicy: Q-learning + REINFORCE\nPositive credit needs independent attribution\nPRM: step rewards; sentinel: proxy distrust\nCalibration: predicted vs actual (Brier)"];
    Retain [fillcolor="#fcd34d", label="5  RETAIN UNDER ~/.pwn/\npolicy.json + policy_traj.jsonl\nsessions/*.jsonl: step_reward\nreward_sentinel.json + mistakes.json\npreferences.jsonl: scrubbed trajectory pairs"];
    Later [fillcolor="#7dd3fc", label="6  INFORM LATER TURNS\nRegistry ranking + advisory policy context\nWarmup and episode budget apply\nRSI records ESR / ASR; ESR drop → lesson\nNo automatic policy-candidate promotion"];
    Run -> Diagnose -> Evidence -> Credit -> Retain -> Later;
  }

  subgraph cluster_curriculum {
    label="OPTIONAL CURRICULUM  ·  independent invocation"; fontsize=12;
    style="rounded,dashed,filled"; color="#94a3b8"; fillcolor="#1e293b";
    Schedule [fillcolor="#7dd3fc", label="A  OPT IN / INVOKE EXPLICITLY\nCron seeds disabled by default:\npractice 03:00; offline_judge 03:30 daily\ntrain dry_run 04:00 Sunday\nSeeding jobs does not install system crontab"];
    Practice [fillcolor="#6ee7b7", label="B  PRACTICE / OFFLINE JUDGING\nPractice: budget-first; real tools may run\nJudge-qualified resolution + winning traces\nOffline judge: backfill, calibrate, warm sentinel\nRecords: curriculum/ + mistakes / preferences"];
    Export [fillcolor="#fcd34d", label="C  EXPORT TRAINING DATA\nLearning.export_finetune + Reward.export_dpo\nEligible sessions / outcomes + preference pairs\nScrub, geometry and source-balance filters\nOutput: finetune/*.jsonl + evaluation set"];
    Train [fillcolor="#fda4af", label="D  train_and_gate\nDry run or no trainer → export_ready only\nOtherwise: configured trainer → LoRA adapter\nollama create → candidate vs baseline gate\nPreference-diet gate also required"];
    Model [fillcolor="#6ee7b7", label="E  RETAIN GATED ADAPTER VERSION\nOn passing gates: update curriculum model state\nOptional local weight path, not routing policy\nExport alone is not training or improvement"];
    Hygiene [fillcolor="#1e293b", fontcolor="#cbd5e1", style="rounded,dashed,filled",
      label="SEPARATE ENABLED HYGIENE SEED\nLearning.consolidate at 05:00 daily\nMemory maintenance, not model training\nESR = verified_exploit_tools / vulnerable_tools\nASR = successful_attacks / total_attack_attempts"];
    Schedule -> Practice [label="independent jobs; not a job chain", style=dashed];
    Practice -> Export [label="eligible retained data", style=dashed];
    Export -> Train -> Model;
  }

  subgraph cluster_policy {
    label="FROZEN POLICY  ·  explicit operator workflow"; fontsize=12;
    style="rounded,dashed,filled"; color="#94a3b8"; fillcolor="#1e293b";
    Select [label="I  SELECT SNAPSHOTS\nExplicit baseline + candidate policy bytes\nPolicyEvaluation; not live online writers\nNo automatic handoff from RSI or training"];
    Eval [label="II  EVALUATE LOCALLY\nPublic fixed held-out tasks\nOff / baseline / candidate comparisons\nTwo disposable filesystem environments\nRegression replay is a separate split"];
    Gate [fillcolor="#fcd34d", label="III  REPLAY ACCEPTANCE\nFresh replay + aggregate nonregression\nPer-task nonregression + held-out gain\nLocal controller evidence only\nNot proof of general live LLM gains"];
    Approve [fillcolor="#6ee7b7", label="IV  OPERATOR APPROVAL\nExplicit live policy target\nApproval + stopped writers required\nReplace routing policy, not model weights"];
    Receipt [fillcolor="#fcd34d", label="V  RETAIN RECEIPT / ROLLBACK\nVersioned receipt v1 + byte digests\nRollback refuses intervening live writes\nNo silent overwrite of newer policy state"];
    Select -> Eval -> Gate -> Approve -> Receipt;
  }
  {rank=same; Run; Schedule; Select}
  {rank=same; Diagnose; Practice; Eval}
  {rank=same; Evidence; Export; Gate}
  {rank=same; Credit; Train; Approve}
  {rank=same; Retain; Model; Receipt}
  {rank=same; Later; Hygiene}
}
